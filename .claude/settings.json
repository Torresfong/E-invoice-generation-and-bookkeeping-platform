{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git branch -D *)",
      "Bash(git rebase *)",
      "Bash(rm *)",
      "Bash(sudo *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git restore *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git rebase *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(npm publish *)",
      "PowerShell(pnpm publish *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh pr review * --approve *)",
      "Bash(gh api *merge*)",
      "Bash(git merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git push origin HEAD:refs/heads/main *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(gh pr review * --approve *)",
      "PowerShell(gh api *merge*)",
      "PowerShell(git merge *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main *)",
      "PowerShell(git push origin HEAD:main *)",
      "PowerShell(git push origin HEAD:refs/heads/main *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(!.env.sample)",
      "Read(!.env.template)",
      "Read(secrets/**)",
      "Read(.aws/credentials)",
      "Read(.npmrc)",
      "Read(.pypirc)",
      "Read(credentials.json)",
      "Read(service-account*.json)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(*.p12)",
      "Read(*.pfx)",
      "Read(id_rsa)",
      "Read(id_ed25519)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-python-heredoc.py"
            ],
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
