#: myinvois/field_rules.py:204
#, python-format
msgid "The %(field)s must be %(limit)s characters or fewer."
msgstr "%(field)s不能超过%(limit)s个字符。"

#: myinvois/field_rules.py:209
#, python-format
msgid "The %(field)s is not on LHDN's list."
msgstr "%(field)s不在LHDN的代码表中。"

#: myinvois/field_rules.py:242
#, python-format
msgid ""
"The %(field)s must be 8 to 20 characters, with an optional + at the start "
"and no spaces."
msgstr "%(field)s须为8到20个字符，开头可以有一个+，中间不能有空格。"

#: myinvois/field_rules.py:249 myinvois/field_rules.py:264
#, python-format
msgid "Enter the %(field)s, or NA if there is none."
msgstr "请填写%(field)s；如果没有，请填NA。"

#: myinvois/field_rules.py:257
#, python-format
msgid ""
"The %(field)s can only use letters, digits, a dash, and one semicolon "
"between two numbers."
msgstr "%(field)s只能使用字母、数字、连字符，以及一个分号来分隔两个号码。"

#: myinvois/field_rules.py:271
#, python-format
msgid "The %(field)s can only use letters, digits and a dash."
msgstr "%(field)s只能使用字母、数字和连字符。"

#: myinvois/field_rules.py:307
#, python-format
msgid "The %(field)s must be 5 digits."
msgstr "%(field)s须为5位数字。"

#: myinvois/field_rules.py:320
#, python-format
msgid "The %(field)s is not a valid LHDN state."
msgstr "%(field)s不是有效的LHDN州属代码。"

#: myinvois/field_rules.py:329
#, python-format
msgid "The %(field)s must be a decimal amount."
msgstr "%(field)s须为十进制金额。"

#: myinvois/submission.py:55
#, python-format
msgid "Invoice %(number)s must be approved again"
msgstr "发票 %(number)s 需要重新批准"

#: myinvois/submission.py:57
#, python-format
msgid ""
"Invoice %(number)s was not sent to LHDN within 72 hours of its issue time, "
"and LHDN no longer accepts it. Your draft is kept. Please review it and "
"approve it again."
msgstr ""
"发票 %(number)s 在开具后 72 小时内未能提交给 LHDN，LHDN 已不再接受。您的草稿"
"已保留，请检查后重新批准。"
