#, python-format
msgid "The %(field)s is not on LHDN's list."
msgstr "%(field)s不在LHDN的代码表中。"

#, python-format
msgid ""
"The %(field)s must be 8 to 20 characters, with an optional + at the start "
"and no spaces."
msgstr "%(field)s须为8到20个字符，开头可以有一个+，中间不能有空格。"

#, python-format
msgid "Enter the %(field)s, or NA if there is none."
msgstr "请填写%(field)s；如果没有，请填NA。"

#, python-format
msgid ""
"The %(field)s can only use letters, digits, a dash, and one semicolon "
"between two numbers."
msgstr "%(field)s只能使用字母、数字、连字符，以及一个分号来分隔两个号码。"

