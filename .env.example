# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=accounting
POSTGRES_PASSWORD=changeme
POSTGRES_DB=accounting
POSTGRES_PORT=5432
DATABASE_URL=postgresql://accounting:changeme@db:5432/accounting

# --- Backend (Django) ---
BACKEND_PORT=8000
SECRET_KEY=changeme
# One of development, staging or production. The app will not start with any other value.
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Owner self-registration (D48, D49) ---
# Off unless "true". The app refuses to start with it on outside development until two-factor authentication is done (D40 (7)).
SIGNUP_ENABLED=false

# --- MyInvois signing certificates (D13) ---
# The name of each certificate in the key vault. Never put a key or certificate here. They must differ.
MYINVOIS_SANDBOX_CERTIFICATE_REF=
MYINVOIS_PRODUCTION_CERTIFICATE_REF=

# --- Background jobs (ADR 0001) ---
# Days to keep finished (done or failed) jobs before the daily purge deletes them. At least 1; the app will not start otherwise.
JOB_RETENTION_DAYS=30
