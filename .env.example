# Copy to .env and fill in real values. Never commit .env.

# --- Database (PostgreSQL 16) ---
POSTGRES_USER=accounting
POSTGRES_PASSWORD=changeme
POSTGRES_DB=accounting
POSTGRES_PORT=5432
DATABASE_URL=postgresql://accounting:changeme@db:5432/accounting

# --- Backend (Django) ---
BACKEND_PORT=8000
SECRET_KEY=changeme
# One of development, staging or production. The app will not start with any other value.
ENVIRONMENT=development
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Owner self-registration (D48, D49) ---
# Off unless "true". The app refuses to start with it on outside development until two-factor authentication is done (D40 (7)).
SIGNUP_ENABLED=false

# --- Email through the Amazon SES API (D68) ---
# With no sender address no email adapter is installed and `check --deploy` warns. No AWS credential goes here: the task's IAM
# role supplies it. SES has no SMTP endpoint in ap-southeast-5, so there is no SMTP setting.
EMAIL_SENDER_ADDRESS=
EMAIL_REGION=ap-southeast-5

# --- MyInvois signing certificates (D13, D65) ---
# The name of each certificate in the key vault. Never put a key or certificate here. The two may be equal: one
# certificate can serve both environments (D65).
MYINVOIS_SANDBOX_CERTIFICATE_REF=
MYINVOIS_PRODUCTION_CERTIFICATE_REF=

# --- MyInvois intermediary login and TIN validation (D14, D57, D58) ---
# One set per environment, held outside the repository and never logged. The app and the worker install the real gateway at
# start-up from the set of the environment they run in (ENVIRONMENT above); left empty, none is installed, a customer
# with a TIN cannot be saved, and the sandbox contract tests skip. LHDN's preprod base URL is in its SDK; production is a
# separate set with a separate secret.
MYINVOIS_SANDBOX_BASE_URL=
MYINVOIS_SANDBOX_CLIENT_ID=
MYINVOIS_SANDBOX_CLIENT_SECRET=
MYINVOIS_PRODUCTION_BASE_URL=
MYINVOIS_PRODUCTION_CLIENT_ID=
MYINVOIS_PRODUCTION_CLIENT_SECRET=
# Sandbox contract tests only (backend/core/tests/test_myinvois_contract.py). Test taxpayers we control, never client data (D60 (4)).
MYINVOIS_SANDBOX_COMPANY_B_TIN=
MYINVOIS_SANDBOX_COMPANY_B_ROB=
MYINVOIS_SANDBOX_UNAUTHORISED_TIN=
MYINVOIS_SANDBOX_BUYER_TIN=
MYINVOIS_SANDBOX_BUYER_ID_TYPE=
MYINVOIS_SANDBOX_BUYER_ID_VALUE=
MYINVOIS_SANDBOX_UNKNOWN_BUYER_TIN=

# --- Background jobs (ADR 0001) ---
# Days to keep finished (done or failed) jobs before the daily purge deletes them. At least 1; the app will not start otherwise.
JOB_RETENTION_DAYS=30
